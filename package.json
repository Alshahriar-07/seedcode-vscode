{
  "name": "seedcode",
  "displayName": "SeedCode CLI",
  "description": "Run the SeedCode CLI AI coding agent in a dedicated Activity Bar sidebar or an editor tab.",
  "version": "2.1.4",
  "publisher": "alshahriar",
  "author": {
    "name": "Al Shahriar Sowan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alshahriar-07/seedcode-vscode"
  },
  "icon": "assets/logo.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "seedcode",
    "ai",
    "agent",
    "coding agent",
    "terminal",
    "assistant"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:seedcode.cliView",
    "onCommand:seedcode.open",
    "onCommand:seedcode.openInEditor",
    "onCommand:seedcode.launch",
    "onCommand:seedcode.install",
    "onCommand:seedcode.checkInstallation",
    "onCommand:seedcode.restart",
    "onCommand:seedcode.openTerminal"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "seedcode",
          "title": "SeedCode",
          "icon": "assets/seedcode.svg"
        }
      ]
    },
    "views": {
      "seedcode": [
        {
          "type": "webview",
          "id": "seedcode.cliView",
          "name": "SeedCode CLI"
        }
      ]
    },
    "commands": [
      {
        "command": "seedcode.open",
        "title": "Open in Sidebar",
        "category": "SeedCode CLI"
      },
      {
        "command": "seedcode.openInEditor",
        "title": "Open in Editor Tab",
        "category": "SeedCode CLI",
        "icon": {
          "light": "assets/seedcode-colored-with-bg.svg",
          "dark": "assets/seedcode-colored-with-bg.svg"
        }
      },
      {
        "command": "seedcode.launch",
        "title": "Launch CLI",
        "category": "SeedCode CLI",
        "icon": "$(play)"
      },
      {
        "command": "seedcode.install",
        "title": "Install CLI",
        "category": "SeedCode CLI",
        "icon": "$(cloud-download)"
      },
      {
        "command": "seedcode.checkInstallation",
        "title": "Check Installation",
        "category": "SeedCode CLI",
        "icon": "$(sync)"
      },
      {
        "command": "seedcode.restart",
        "title": "Restart CLI",
        "category": "SeedCode CLI",
        "icon": "$(refresh)"
      },
      {
        "command": "seedcode.openTerminal",
        "title": "Focus Sidebar",
        "category": "SeedCode CLI",
        "icon": "$(layout-sidebar-left)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "seedcode.openInEditor",
          "when": "view == seedcode.cliView",
          "group": "navigation@0"
        },
        {
          "command": "seedcode.restart",
          "when": "view == seedcode.cliView",
          "group": "navigation@1"
        },
        {
          "command": "seedcode.checkInstallation",
          "when": "view == seedcode.cliView",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "seedcode.openInEditor",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "seedcode.open"
        },
        {
          "command": "seedcode.openInEditor"
        },
        {
          "command": "seedcode.launch"
        },
        {
          "command": "seedcode.install"
        },
        {
          "command": "seedcode.checkInstallation"
        },
        {
          "command": "seedcode.restart"
        },
        {
          "command": "seedcode.openTerminal"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node-pty --format=cjs --platform=node --sourcemap",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node-pty --format=cjs --platform=node --minify",
    "test": "npx esbuild ./test/runTests.ts --bundle --outfile=dist/test.js --alias:vscode=./test/mockVscode.ts --external:node-pty --format=cjs --platform=node && node dist/test.js",
    "typecheck": "tsc --noEmit",
    "vscode:package": "vsce package -o seedcode-vscode-2.1.4.vsix"
  },
  "dependencies": {
    "node-pty": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
